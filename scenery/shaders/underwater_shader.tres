[gd_resource type="ShaderMaterial" load_steps=4 format=3]

[ext_resource type="Texture2D" path="res://scenery/shaders/shader_textures/Water_N_A.png" id="1"]
[ext_resource type="Texture2D" path="res://scenery/shaders/shader_textures/Water_N_B.png" id="2"]

[sub_resource type="Shader" id="1"]
code = "shader_type spatial;
render_mode unshaded, cull_back, depth_draw_never;

uniform sampler2D screen_texture : hint_screen_texture, filter_linear, repeat_disable;
uniform sampler2D ripple_a : hint_normal, filter_linear_mipmap, repeat_enable;
uniform sampler2D ripple_b : hint_normal, filter_linear_mipmap, repeat_enable;
uniform vec4 water_tint : source_color = vec4(0.16, 0.44, 0.57, 1.0);

varying vec2 world_xz;

void vertex() {
	world_xz = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xz;
}

void fragment() {
	vec2 ripple = texture(ripple_a, world_xz * 0.22 + TIME * vec2(0.025, 0.013)).rg - 0.5;
	ripple += texture(ripple_b, world_xz * 0.34 + TIME * vec2(-0.018, 0.021)).rg - 0.5;

	vec3 surface_normal = normalize(NORMAL + TANGENT * ripple.x * 0.3 + BINORMAL * ripple.y * 0.3);
	float facing = clamp(dot(surface_normal, VIEW), 0.0, 1.0);
	// Approximate the bright window overhead and the darker surface at grazing angles.
	float transmission = smoothstep(0.57, 0.75, facing);
	vec2 refracted_uv = clamp(SCREEN_UV + ripple * 0.025, vec2(0.001), vec2(0.999));
	vec3 refracted = texture(screen_texture, refracted_uv).rgb;
	vec3 grazing_color = water_tint.rgb * (0.55 + 0.22 * ripple.y);
	vec3 transmitted_color = mix(refracted, water_tint.rgb, 0.32) * 0.85;
	ALBEDO = mix(grazing_color, transmitted_color, transmission);
	ALPHA = 1.0;
}
"

[resource]
shader = SubResource("1")
shader_parameter/ripple_a = ExtResource("1")
shader_parameter/ripple_b = ExtResource("2")
